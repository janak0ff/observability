# ============================================================
# Client Node — Environment Configuration
# Copy this file to .env and fill in the required values.
# ============================================================

# ── Identity ──────────────────────────────────────────────────
# Project name used as prefix for Docker resources (network, volumes)
COMPOSE_PROJECT_NAME=observability-client

# The display name of this node. Must be unique per client.
# Appears as the "host" label in ALL Prometheus metrics and Loki logs.
# Do NOT use "HOSTNAME" — it is a reserved shell variable.
NODE_HOSTNAME=client1

# Environment tag attached to every metric and log line.
ENVIRONMENT=production

# ── Exporter Ports ────────────────────────────────────────────
# Change these only if the defaults conflict with another service.
NODE_EXPORTER_PORT=9100
ALLOY_PORT=12345
PROCESS_EXPORTER_PORT=9256

# ── Server Connection ─────────────────────────────────────────
# Replace with the actual public IP of your observability server.
# This is where Alloy pushes logs (Loki) and metrics (Prometheus).
LOKI_URL=http://<SERVER_IP>:3100/loki/api/v1/push
PROMETHEUS_URL=http://<SERVER_IP>:9090/api/v1/write

# ── Optional Exporters ────────────────────────────────────────
# Uncomment and fill in the section for any app you want to monitor.
# Then uncomment the matching service block in docker-compose.yml.

# --- NGINX ---
# NGINX_EXPORTER_PORT=9113
# NGINX_STATUS_URL=http://localhost:80/status

# --- Jenkins ---
# JENKINS_EXPORTER_PORT=8080
# JENKINS_URL=http://localhost:8080
# JENKINS_USER=admin
# JENKINS_PASSWORD=your-api-token

# --- PostgreSQL ---
# POSTGRES_EXPORTER_PORT=9187
# POSTGRES_USER=exporter
# POSTGRES_PASSWORD=strong-password
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres

# --- MySQL ---
# MYSQL_EXPORTER_PORT=9104
# MYSQL_USER=exporter
# MYSQL_PASSWORD=strong-password
# MYSQL_HOST=mysql
# MYSQL_PORT=3306

# --- Redis ---
# REDIS_EXPORTER_PORT=9121
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=
