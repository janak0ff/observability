# ==============================================================================
# Observability Client Environment Configuration
# Copy this file to .env and modify as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Settings (Required)
# ------------------------------------------------------------------------------

# The hostname of this machine (used in Prometheus/Loki to identify the source)
# NOTE: Do not use the variable 'HOSTNAME' as it conflicts with Docker Compose.
NODE_HOSTNAME=ubuntu35

# The environment this node belongs to (e.g., production, staging, development)
ENVIRONMENT=production

# The URL where Alloy will push logs to Loki.
# This should point to your central monitoring server.
LOKI_URL=http://<ip>:3100/loki/api/v1/push

# The URL where Alloy will remote-write metrics to Prometheus.
PROMETHEUS_URL=http://<ip>:9090/api/v1/write

# ------------------------------------------------------------------------------
# 2. Port Configuration
# ------------------------------------------------------------------------------

# These are the ports exposed on the host machine.
# Ensure Prometheus on the Monitor server is configured to scrape these ports.
NODE_EXPORTER_PORT=9100
ALLOY_PORT=12345
PROCESS_EXPORTER_PORT=9256
CADVISOR_PORT=9338

# ------------------------------------------------------------------------------
# 3. Optional Exporter Profiles
# ------------------------------------------------------------------------------
# To enable an optional exporter, add its profile name to a comma-separated
# list in the COMPOSE_PROFILES variable.
# Example: COMPOSE_PROFILES=nginx,jenkins

# Leave empty or comment out to run only the core exporters
# COMPOSE_PROFILES=nginx

# --- Nginx Exporter ---
# Port exposed by the Nginx exporter
NGINX_EXPORTER_PORT=9113
# URL where your Nginx stub_status is exposed
NGINX_STATUS_URL=http://<ip>:80/nginx_status

# --- Jenkins Exporter ---
# Port exposed by the Jenkins exporter
JENKINS_EXPORTER_PORT=9506
# URL and credentials for your Jenkins instance
JENKINS_URL=http://<ip>:8080
JENKINS_USER=Knght
JENKINS_PASSWORD=api-token #api token
