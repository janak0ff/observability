// Alloy configuration for log collection and metrics

// Log collection from Docker Daemon
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.filter_logs.receiver]
}

// Process and filter logs
loki.process "filter_logs" {
  forward_to = [loki.write.server.receiver]
  
  // Add labels
  stage.static_labels {
    values = {
      host = env("HOSTNAME"),
      environment = "production",
      collector = "alloy",
    }
  }
  
  // Parse JSON logs if present
  stage.json {
    expressions = {
      level = "",
      message = "",
      timestamp = "",
    }
    source = "log_line"
  }
  
  // Extract timestamp if available
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }
  
  // Drop debug logs
  stage.drop {
    source = "level"
    value = "debug"
  }
}

// Send logs to Loki
loki.write "server" {
  endpoint {
    url = env("LOKI_URL")
    
    // Add basic authentication if needed
    // basic_auth {
    //   username = "username"
    //   password = "password"
    // }
    
    // Add tenant ID if using multi-tenancy
    // headers = {
    //   "X-Scope-OrgID": "tenant1",
    // }
  }
  
  external_labels = {
    host = env("HOSTNAME"),
    job = "alloy",
  }
}

// Scrape Docker container metrics
prometheus.scrape "docker" {
  targets = [
    {"__address__" = "localhost:9323", "job" = "docker"},
  ]
  forward_to = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "30s"
}

// Remote write to Prometheus
prometheus.remote_write "metrics" {
  endpoint {
    url = env("PROMETHEUS_URL")
    
    // Add authentication if needed
    // basic_auth {
    //   username = "username"
    //   password = "password"
    // }
  }
}