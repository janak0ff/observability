// Alloy configuration for log collection and metrics

// Log collection from various sources
loki.source.file "log_files" {
  targets = [
    {__path__ = "/var/lib/docker/containers/*/*.log", "job" = "docker_containers"},
  ]
  forward_to = [loki.process.filter_logs.receiver]
}

// Process and filter logs
loki.process "filter_logs" {
  forward_to = [loki.write.server.receiver]
  
  // Add labels
  stage.static_labels {
    values = {
      host = env("HOSTNAME"),
      environment = "production",
      collector = "alloy",
    }
  }
  
  // Parse JSON logs if present
  stage.json {
    expressions = {
      level = "",
      message = "",
      timestamp = "",
    }
    source = "log_line"
  }
  
  // Extract timestamp if available
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }
  
  // Drop debug logs
  stage.drop {
    source = "level"
    value = "debug"
  }
}

// Send logs to Loki
loki.write "server" {
  endpoint {
    url = env("LOKI_URL")
    
    // Add basic authentication if needed
    // basic_auth {
    //   username = "username"
    //   password = "password"
    // }
    
    // Add tenant ID if using multi-tenancy
    // headers = {
    //   "X-Scope-OrgID": "tenant1",
    // }
  }
  
  external_labels = {
    host = env("HOSTNAME"),
    job = "alloy",
  }
}

// Scrape Docker container metrics
prometheus.scrape "docker" {
  targets = [
    {"__address__" = "localhost:9323", "job" = "docker"},
  ]
  forward_to = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "30s"
}

// Remote write to Prometheus
prometheus.remote_write "metrics" {
  endpoint {
    url = env("PROMETHEUS_URL")
    
    // Add authentication if needed
    // basic_auth {
    //   username = "username"
    //   password = "password"
    // }
  }
}