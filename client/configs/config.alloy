// Alloy configuration for log collection and metrics

// ============================================================
// HOST SYSTEM LOG COLLECTION (/var/log)
// ============================================================

// Package manager logs: apt & dpkg
loki.source.file "apt_logs" {
  targets = [
    {__path__ = "/var/log/dpkg.log",       "job" = "package_manager", "app" = "dpkg",   "log_type" = "packages"},
    {__path__ = "/var/log/apt/history.log", "job" = "package_manager", "app" = "apt",    "log_type" = "packages"},
    {__path__ = "/var/log/apt/term.log",    "job" = "package_manager", "app" = "apt",    "log_type" = "packages"},
  ]
  forward_to = [loki.process.system_logs.receiver]
}

// Boot & system logs
loki.source.file "boot_logs" {
  targets = [
    {__path__ = "/var/log/boot.log",        "job" = "system", "app" = "boot",         "log_type" = "boot"},
    {__path__ = "/var/log/alternatives.log","job" = "system", "app" = "alternatives", "log_type" = "system"},
    {__path__ = "/var/log/fontconfig.log",  "job" = "system", "app" = "fontconfig",   "log_type" = "system"},
  ]
  forward_to = [loki.process.system_logs.receiver]
}

// Display server logs (Xorg / sddm)
loki.source.file "display_logs" {
  targets = [
    {__path__ = "/var/log/Xorg.0.log",      "job" = "display", "app" = "xorg", "log_type" = "display"},
    {__path__ = "/var/log/sddm.log",         "job" = "display", "app" = "sddm", "log_type" = "display"},
  ]
  forward_to = [loki.process.system_logs.receiver]
}

// Printing logs (CUPS)
loki.source.file "cups_logs" {
  targets = [
    {__path__ = "/var/log/cups/access_log",  "job" = "cups", "app" = "cups", "log_type" = "access"},
    {__path__ = "/var/log/cups/error_log",   "job" = "cups", "app" = "cups", "log_type" = "error"},
  ]
  forward_to = [loki.process.system_logs.receiver]
}

// Process pipeline for system logs (minimal processing, preserve plain-text format)
loki.process "system_logs" {
  forward_to = [loki.write.server.receiver]

  stage.static_labels {
    values = {
      host        = env("HOSTNAME"),
      environment = "production",
      collector   = "alloy",
    }
  }
}


// Log collection from Docker Daemon
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "app"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.filter_logs.receiver]
}

// Process and filter logs
loki.process "filter_logs" {
  forward_to = [loki.write.server.receiver]
  
  // Add labels
  stage.static_labels {
    values = {
      host = env("HOSTNAME"),
      environment = "production",
      collector = "alloy",
    }
  }
  
  // Parse JSON logs if present
  stage.json {
    expressions = {
      level = "",
      message = "",
      timestamp = "",
    }
    source = "log_line"
  }
  
  // Extract timestamp if available
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }
  
  // Drop debug logs
  stage.drop {
    source = "level"
    value = "debug"
  }
}

// Send logs to Loki
loki.write "server" {
  endpoint {
    url = env("LOKI_URL")
    
    // Add basic authentication if needed
    // basic_auth {
    //   username = "username"
    //   password = "password"
    // }
    
    // Add tenant ID if using multi-tenancy
    // headers = {
    //   "X-Scope-OrgID": "tenant1",
    // }
  }
  
  external_labels = {
    host = env("HOSTNAME"),
    job = "alloy",
  }
}

// Scrape Docker container metrics
prometheus.scrape "docker" {
  targets = [
    {"__address__" = "localhost:9323", "job" = "docker"},
  ]
  forward_to = [prometheus.remote_write.metrics.receiver]
  scrape_interval = "30s"
}

// Remote write to Prometheus
prometheus.remote_write "metrics" {
  endpoint {
    url = env("PROMETHEUS_URL")
    
    // Add authentication if needed
    // basic_auth {
    //   username = "username"
    //   password = "password"
    // }
  }
}