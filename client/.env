# ============================================================
# Client Node — Environment Configuration
# Copy this file to .env and fill in the required values.
# ============================================================

# ── Identity ──────────────────────────────────────────────────
# Project name used as prefix for Docker resources (network, volumes)
COMPOSE_PROJECT_NAME=observability-client

# The display name of this node. Must be unique per client.
# Appears as the "host" label in ALL Prometheus metrics and Loki logs.
# Do NOT use "HOSTNAME" — it is a reserved shell variable.
NODE_HOSTNAME=ubuntu35

# Environment tag attached to every metric and log line.
ENVIRONMENT=production

# ── Exporter Ports ────────────────────────────────────────────
# Change these only if the defaults conflict with another service.
NODE_EXPORTER_PORT=9100
ALLOY_PORT=12345
PROCESS_EXPORTER_PORT=9256

# ── Server Connection ─────────────────────────────────────────
# Replace with the actual public IP of your observability server.
# This is where Alloy pushes logs (Loki) and metrics (Prometheus).
LOKI_URL=http://202.51.74.35:3100/loki/api/v1/push
PROMETHEUS_URL=http://202.51.74.35:9090/api/v1/write

# ── Optional Exporters ────────────────────────────────────────
# Uncomment and fill in the section for any app you want to monitor.
# Then uncomment the matching service block in docker-compose.yml.

# --- Nginx Exporter ---
# Port exposed by the Nginx exporter
NGINX_EXPORTER_PORT=9113
# URL where your Nginx stub_status is exposed
NGINX_STATUS_URL=http://202.51.74.35:80/nginx_status

# --- Jenkins Exporter ---
# Port exposed by the Jenkins exporter
JENKINS_EXPORTER_PORT=9506
# URL and credentials for your Jenkins instance
JENKINS_URL=http://202.51.74.35:8080
JENKINS_USER=Knght
JENKINS_PASSWORD=118a57b7b7856ac2c4f44da2c548ed4be0 #api token

