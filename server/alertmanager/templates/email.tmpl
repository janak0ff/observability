{{ define "email.default.subject" }}
[{{ .Status | toUpper }}] {{ .GroupLabels.alertname }} - {{ .GroupLabels.instance }}
{{ end }}

{{ define "email.default.html" }}
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; }
        .alert { margin: 20px; padding: 15px; border-radius: 5px; }
        .firing { background-color: #ffebee; border-left: 5px solid #f44336; }
        .resolved { background-color: #e8f5e9; border-left: 5px solid #4caf50; }
        h2 { margin-top: 0; }
        .label { font-weight: bold; color: #666; }
        .value { margin-left: 10px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 8px; text-align: left; border-bottom: 1px solid #ddd; }
        th { background-color: #f5f5f5; }
    </style>
</head>
<body>
    <h1>AlertManager Notification</h1>
    
    <div class="alert {{ .Status }}">
        <h2>{{ .Status | toUpper }}: {{ .CommonLabels.alertname }}</h2>
        
        <p><span class="label">Started at:</span> <span class="value">{{ .StartsAt }}</span></p>
        {{ if .EndsAt }}<p><span class="label">Ended at:</span> <span class="value">{{ .EndsAt }}</span></p>{{ end }}
        
        <h3>Labels</h3>
        <table>
            <tr>
                <th>Label</th>
                <th>Value</th>
            </tr>
            {{ range $key, $value := .CommonLabels }}
            <tr>
                <td>{{ $key }}</td>
                <td>{{ $value }}</td>
            </tr>
            {{ end }}
        </table>
        
        <h3>Alerts</h3>
        {{ range .Alerts }}
        <div style="margin: 10px 0; padding: 10px; background-color: #f9f9f9; border-radius: 3px;">
            <h4>{{ .Labels.instance }}</h4>
            <p><strong>Summary:</strong> {{ .Annotations.summary }}</p>
            <p><strong>Description:</strong> {{ .Annotations.description }}</p>
        </div>
        {{ end }}
    </div>
</body>
</html>
{{ end }}

{{ define "email.critical.html" }}
<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; background-color: #fff0f0; }
        .critical { color: #d32f2f; font-weight: bold; }
        .alert { margin: 20px; padding: 20px; border: 2px solid #d32f2f; border-radius: 5px; background-color: white; }
        .urgent { background-color: #ffebee; padding: 15px; border-radius: 3px; margin: 10px 0; }
    </style>
</head>
<body>
    <div class="alert">
        <h1 class="critical">🚨 CRITICAL ALERT 🚨</h1>
        <div class="urgent">
            <h2>{{ .CommonLabels.alertname }}</h2>
            <p><strong>Instance:</strong> {{ .CommonLabels.instance }}</p>
            <p><strong>Severity:</strong> {{ .CommonLabels.severity }}</p>
        </div>
        
        {{ template "email.default.html" . }}
        
        <p style="color: #d32f2f; font-weight: bold;">IMMEDIATE ATTENTION REQUIRED</p>
    </div>
</body>
</html>
{{ end }}