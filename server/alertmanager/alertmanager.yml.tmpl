global:
  resolve_timeout: 5m
  smtp_smarthost: 'smtp.gmail.com:587'
  smtp_from: '${SMTP_FROM}'
  smtp_auth_username: '${SMTP_AUTH_USERNAME}'
  # Gmail App Password — set in .env (never hardcode here)
  smtp_auth_password: '${SMTP_AUTH_PASSWORD}'
  smtp_require_tls: true

templates:
  - '/etc/alertmanager/templates/*.tmpl'

# ============================================================
# Routing Rules
# ============================================================
route:
  # Group alerts together by these labels so you don't get spammed with 100 emails at once
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  # How long to wait before sending a reminder email if the alert is STILL firing
  repeat_interval: '${REPEAT_INTERVAL}'
  receiver: 'email-alerts'

  routes:
    - match:
        severity: critical
      receiver: 'email-alerts'
      group_wait: 10s
      # Critical alerts get repeated reminders much faster (1 hour)
      repeat_interval: 1h

    - match:
        severity: warning
      receiver: 'email-alerts'
      group_wait: 1m
      repeat_interval: '${REPEAT_INTERVAL}'

receivers:
  - name: 'email-alerts'
    email_configs:
      - to: '${DEFAULT_ALERT_EMAIL}'
        send_resolved: true
        headers:
          subject: '[{{ .Status | toUpper }}] {{ .CommonLabels.alertname }} - {{ .CommonAnnotations.summary }}'
        html: '{{ template "email.custom.html" . }}'

inhibit_rules:
  - source_match:
      severity: 'critical'
    target_match:
      severity: 'warning'
    equal: ['alertname', 'instance']