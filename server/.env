# ============================================================
# Observability Stack — Environment Configuration
# ============================================================

COMPOSE_PROJECT_NAME=observability

# ── Environment ──────────────────────────────────────────────
ENVIRONMENT=development

# Your public domain (only needed when running with --profile nginx)
DOMAIN=monitoring.yourcompany.com

# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB
# Dev: 15s  |  Production: 30s
SCRAPE_INTERVAL=15s
SCRAPE_TIMEOUT=10s

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SecurePass123!
# Dev: http://localhost:3000  |  Production: https://yourdomain.com/grafana
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_SERVE_FROM_SUBPATH=false
# Dev: false  |  Production: true
GRAFANA_COOKIE_SECURE=false
GRAFANA_ANONYMOUS_ACCESS=false
GRAFANA_LOG_LEVEL=warn

# ── Loki ─────────────────────────────────────────────────────
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=720h
# Dev: filesystem  |  Production: filesystem or s3
LOKI_STORAGE_TYPE=filesystem

# ── AWS S3 (only needed when LOKI_STORAGE_TYPE=s3) ───────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# LOKI_BUCKET_NAME=loki-logs-prod

# ── AWS EC2 Service Discovery ────────────────────────────────
# Separate read-only key with only ec2:DescribeInstances permission.
# Leave blank to use an IAM instance role on the Prometheus server.
# AWS_EC2_SD_ACCESS_KEY_ID=
# AWS_EC2_SD_SECRET_ACCESS_KEY=

# ── Alertmanager ─────────────────────────────────────────────
ALERTMANAGER_PORT=9093
# Dev: http://localhost:9093  |  Production: https://yourdomain.com/alertmanager
ALERTMANAGER_EXTERNAL_URL=http://localhost:9093
ALERTMANAGER_LOG_LEVEL=warn

# ── Alertmanager SMTP (Gmail) ────────────────────────────────
SMTP_FROM=janak.shrestha.it@gmail.com
SMTP_AUTH_USERNAME=janak.shrestha.it@gmail.com
# Generate at: https://myaccount.google.com/apppasswords
SMTP_AUTH_PASSWORD=wadyhxqqaiykbkav

# The address that RECEIVES the alerts
DEFAULT_ALERT_EMAIL=janak123g@gmail.com

# ── Monitored Servers ────────────────────────────────────────
# Dev: local machine  |  Production: replace with real server IPs
CLIENT_NODE_1=host.docker.internal:9100
# CLIENT_NODE_2=10.0.1.11:9100
# CLIENT_NODE_3=10.0.1.12:9100