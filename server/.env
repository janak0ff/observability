# Server Configuration
COMPOSE_PROJECT_NAME=observability-server

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=SecurePass123!
GRAFANA_ANONYMOUS_ACCESS=false

# Loki
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=720h  # 30 days in hours

# ============================================
# AWS S3 Configuration (COMMENTED OUT - DEFAULT IS LOCAL STORAGE)
# Uncomment these lines if you want to use S3 storage
# ============================================
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# 
# # Loki S3 Buckets
# LOKI_BUCKET_NAME=loki-logs-bucket
# LOKI_RULER_BUCKET_NAME=loki-ruler-bucket
# LOKI_S3_URL=s3://${AWS_ACCESS_KEY_ID}:${AWS_SECRET_ACCESS_KEY}@${AWS_REGION}/${LOKI_BUCKET_NAME}
# LOKI_RULER_S3_URL=s3://${AWS_ACCESS_KEY_ID}:${AWS_SECRET_ACCESS_KEY}@${AWS_REGION}/${LOKI_RULER_BUCKET_NAME}
# ============================================

# Alertmanager
ALERTMANAGER_PORT=9093

# Slack Webhook for Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM=alerts@yourdomain.com
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Alert Emails
DEFAULT_ALERT_EMAIL=team@yourdomain.com
CRITICAL_ALERT_EMAIL=oncall@yourdomain.com
WARNING_ALERT_EMAIL=alerts@yourdomain.com

# Client Nodes (add as many as needed)
CLIENT_NODE_1=client1:9100
CLIENT_NODE_2=client2:9100
CLIENT_NODE_3=client3:9100