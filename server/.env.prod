# ============================================================
# Production Environment Template
# Copy to .env and fill in all values before deploying.
# NEVER commit the real .env file to version control!
# ============================================================

# ── Server ──────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=observability-prod

# Your public domain (e.g. monitoring.yourcompany.com)
DOMAIN=monitoring.yourcompany.com

# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=20GB

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# ── Loki ─────────────────────────────────────────────────────
LOKI_RETENTION_PERIOD=720h  # 30 days
LOKI_STORAGE_TYPE=filesystem   # Change to "s3" and set AWS vars below to use S3

# ── Alertmanager SMTP ────────────────────────────────────────
# The Gmail account that SENDS the alerts (SMTP login)
SMTP_FROM=your-sender@gmail.com
SMTP_AUTH_USERNAME=your-sender@gmail.com
# Generate a Gmail App Password at: https://myaccount.google.com/apppasswords
SMTP_AUTH_PASSWORD=xxxx_xxxx_xxxx_xxxx

# The address that RECEIVES the alerts
DEFAULT_ALERT_EMAIL=oncall@yourcompany.com

# ── AWS S3 (optional — for Loki object storage) ──────────────
# Uncomment and fill in to store Loki logs durably in S3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# LOKI_BUCKET_NAME=my-loki-logs-prod

# ── Client Nodes ─────────────────────────────────────────────
# Add the IP or DNS name of each server running node_exporter
CLIENT_NODE_1=10.0.1.10:9100
CLIENT_NODE_2=10.0.1.11:9100
# CLIENT_NODE_3=10.0.1.12:9100
