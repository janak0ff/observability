# ============================================================
# Observability Stack — Environment Configuration
# Copy this file to .env and fill in your values.
# Works for both local dev and production — just change the values.
# ============================================================

COMPOSE_PROJECT_NAME=observability

# ── Environment ──────────────────────────────────────────────
# Set to "production" on your cloud server
ENVIRONMENT=production

# Your public domain (only needed when running with --profile nginx)
DOMAIN=monitoring.yourcompany.com

# ── Prometheus ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
PROMETHEUS_RETENTION_SIZE=10GB
# Dev: 15s  |  Production: 30s
SCRAPE_INTERVAL=15s
SCRAPE_TIMEOUT=10s

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Dev: use a simple password  |  Production: use a strong random password
GRAFANA_ADMIN_PASSWORD=admin123
# Dev: http://localhost:3000  |  Production: https://yourdomain.com/grafana
GRAFANA_ROOT_URL=http://202.51.74.196:3000
GRAFANA_SERVE_FROM_SUBPATH=false
# Dev: false  |  Production: true
GRAFANA_COOKIE_SECURE=false
GRAFANA_ANONYMOUS_ACCESS=false
GRAFANA_LOG_LEVEL=warn

# ── Loki ─────────────────────────────────────────────────────
LOKI_PORT=3100
LOKI_RETENTION_PERIOD=720h
# Dev: filesystem  |  Production: filesystem or s3
LOKI_STORAGE_TYPE=filesystem

# ── AWS S3 (only needed when LOKI_STORAGE_TYPE=s3) ───────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# LOKI_BUCKET_NAME=my-loki-logs-prod

# ── AWS EC2 Service Discovery ─────────────────────────────────
# Required: ec2:DescribeInstances IAM permission
# Leave credentials empty to use an IAM instance role on the server.
# AWS_EC2_SD_REGION controls the region for BOTH ec2-sd jobs in prometheus.yml.
# AWS_EC2_SD_REGION=us-east-1
# AWS_EC2_SD_ACCESS_KEY_ID=
# AWS_EC2_SD_SECRET_ACCESS_KEY=

# ── Alertmanager ─────────────────────────────────────────────
ALERTMANAGER_PORT=9093
# Dev: http://localhost:9093  |  Production: http://<server-ip>:9093
ALERTMANAGER_EXTERNAL_URL=http://202.51.74.196:9093
# Dev: debug  |  Production: warn
ALERTMANAGER_LOG_LEVEL=warn
# How often to send reminder emails for STILL-FIRING alerts (e.g., 4h, 12h, 1d)
ALERT_REPEAT_INTERVAL=4h

# ── Alertmanager SMTP (Gmail) ────────────────────────────────
# The Gmail account that SENDS the alerts
SMTP_FROM=janak.shrestha.it@gmail.com
SMTP_AUTH_USERNAME=janak.shrestha.it@gmail.com
# Generate at: https://myaccount.google.com/apppasswords
SMTP_AUTH_PASSWORD=wadyhxqqaiykbkav

# The address that RECEIVES the alerts
DEFAULT_ALERT_EMAIL=janak123g@gmail.com

